        selectedTopics = []
        if self.Multiplication.get():
            selectedTopics.append("Multiplication")
        if self.Determinant.get():
            selectedTopics.append("Determinant")
        if self.Inverse.get():
            selectedTopics.append("Inverse")
        if self.Transformations.get():
            selectedTopics.append("Transformations")
        if self.SimultaneousEquations.get():
            selectedTopics.append("Simultaneous Equations")

        if not selectedTopics:
            self.InvalidQEntry.config(text="Please select at least one topic.")
            self.InvalidQEntry.place(x=80, y=460)

        self.Questions = {}
        for x in range(1,self.QsNum+1):
            randTopic = selectedTopics[random.randint(0,len(selectedTopics)-1)]
            self.params = []
            if randTopic == "Multiplication":
                self.params = self.matrixMultiplication(x)
            elif randTopic == "Determinant":
                self.params = self.theDeterminant(x)
            elif randTopic == "Inverse":
                self.params = self.inverseMatrix(x)
            elif randTopic == "Transformations":
                self.params = self.matrixTransformations(x)
            elif randTopic == "Simultaneous Equations":
                self.params = self.simultaneousEquations(x)
            self.qframe = Question(self.master, self.controller)
            self.qframe.updateQuestionInfo(self.params[0],self.params[1],self.params[2],self.params[3],self.params[4],self.params[5],self.params[6],self.QsNum)
