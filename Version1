    def matrixMultiplication(self, qNum):
        self.matrix1 = [[random.randint(0,9),random.randint(0,9)],[random.randint(0,9),random.randint(0,9)]]
        self.matrix2 = [[random.randint(0,9),random.randint(0,9)],[random.randint(0,9),random.randint(0,9)]]

        self.questionFormat = f"⎡ {self.matrix1[0][0]}     {self.matrix1[0][1]} ⎤⎡ {self.matrix2[0][0]}     {self.matrix2[0][1]} ⎤\n⎣ {self.matrix1[1][0]}     {self.matrix1[1][1]} ⎦⎣ {self.matrix2[1][0]}     {self.matrix2[1][1]} ⎦"

        self.topLeft = (self.matrix1[0][0]*self.matrix2[0][0])+(self.matrix1[0][1]*self.matrix2[1][0])
        self.topRight = (self.matrix1[0][0]*self.matrix2[0][1])+(self.matrix1[0][1]*self.matrix2[1][1])
        self.bottomLeft = (self.matrix1[1][0]*self.matrix2[0][0])+(self.matrix1[1][1]*self.matrix2[1][0])
        self.bottomRight = (self.matrix1[1][0]*self.matrix2[0][1])+(self.matrix1[1][1]*self.matrix2[1][1])

        self.answer = f"{self.topLeft}     {self.topRight}\n\n{self.bottomLeft}     {self.bottomRight}"

        self.answers = []
        self.answerIn = False
        self.answerSpot = None
        for x in range(0,4):
            decide = random.randint(0,1)
            if x == 3 and self.answerIn == False:
                self.answers.append(self.answer)
                self.answerIn = True
                self.answerSpot = x + 1
            elif decide == 0 and self.answerIn == False:
                self.answers.append(self.answer)
                self.answerIn = True
                self.answerSpot = x + 1
            else:
                self.answers.append(f"{random.randint(self.topLeft-5,self.topLeft+5)}     {random.randint(self.topRight-5,self.topRight+5)}\n\n{random.randint(self.bottomLeft-5,self.bottomLeft+5)}     {random.randint(self.bottomRight-5,self.bottomRight+5)}")
       
        return f"Solve this Matrix multiplication:\n\n{self.questionFormat}", self.answers[0], self.answers[1], self.answers[2], self.answers[3], qNum, self.answerSpot

    def theDeterminant(self,qNum):
        self.matrix = [[random.randint(0,9),random.randint(0,9)],[random.randint(0,9),random.randint(0,9)]]
        self.questionFormat = f"⎡ {self.matrix[0][0]}     {self.matrix[0][1]} ⎤\n⎣ {self.matrix[1][0]}     {self.matrix[1][1]} ⎦"
       
        self.correctDeterminant = self.matrix[0][0]*self.matrix[1][1] - self.matrix[0][1]*self.matrix[1][0]
        self.answer2 = self.matrix[0][1]*self.matrix[1][0] - self.matrix[0][0]*self.matrix[1][1]
        self.answer3 = self.matrix[0][0]*self.matrix[0][1] - self.matrix[1][1]*self.matrix[1][0]
        self.answer4 = random.randint(self.correctDeterminant - 5, self.correctDeterminant + 5)
       
        self.correctAnswer = f"1\n---\n{self.correctDeterminant}"

        self.answers = [f"1\n---\n{self.correctDeterminant}", f" 1\n---\n   {self.answer2}", f" 1\n---\n   {self.answer3}", f" 1\n---\n   {self.answer4}"]
        random.shuffle(self.answers)
        self.answerSpot = self.answers.index(self.correctAnswer) + 1
       

        return f"Find the determinant for this matrix:\n\n{self.questionFormat}", self.answers[0], self.answers[1], self.answers[2], self.answers[3], qNum, self.answerSpot

    def inverseMatrix(self, qNum):
       
        while True:
            self.matrix = [[random.randint(0,9), random.randint(0,9)],[random.randint(0,9), random.randint(0,9)]]

            self.det = (self.matrix[0][0] * self.matrix[1][1] - self.matrix[0][1] * self.matrix[1][0])

            if self.det != 0:
                break

        self.questionFormat = (f"⎡ {self.matrix[0][0]}     {self.matrix[0][1]} ⎤\n"
        f"⎣ {self.matrix[1][0]}     {self.matrix[1][1]} ⎦")

        self.correctAnswer = (f"(1/{self.det}) ⎡ {self.matrix[1][1]}     {-self.matrix[0][1]} ⎤\n"
            f"        ⎣ {-self.matrix[1][0]}     {self.matrix[0][0]} ⎦")

        self.answer2 = (f"(1/{self.det}) ⎡ {self.matrix[0][0]}     {-self.matrix[0][1]} ⎤\n"
            f"        ⎣ {-self.matrix[1][0]}     {self.matrix[1][1]} ⎦")

        self.answer3 = (f"(1/{-self.det}) ⎡ {self.matrix[1][1]}     {-self.matrix[0][1]} ⎤\n"
            f"         ⎣ {-self.matrix[1][0]}     {self.matrix[0][0]} ⎦")

        self.answer4 = (f"(1/{random.randint(self.det - 3, self.det + 3)}) ⎡ {random.randint(-9,9)}     {random.randint(-9,9)} ⎤\n"
            f"         ⎣ {random.randint(-9,9)}     {random.randint(-9,9)} ⎦")


        self.answers = [
            self.correctAnswer,
            self.answer2,
            self.answer3,
            self.answer4
        ]

        random.shuffle(self.answers)
        self.answerSpot = self.answers.index(self.correctAnswer) + 1

        return  f"Find the inverse of this matrix:\n\n{self.questionFormat}", self.answers[0], self.answers[1], self.answers[2], self.answers[3], qNum, self.answerSpot

    def matrixTransformations(self, qNum):
        self.matrix = [[random.randint(0,9),random.randint(0,9)],[random.randint(0,9),random.randint(0,9)]]
        self.choices = ["Reflect this matrix in the x-axis", "Reflect this matrix in the y-axis", "Rotate the matrix by x Degrees"]

        self.choice = random.choice(self.choices)
        self.questionFormat = f"{self.matrix[0][0]}   {self.matrix[0][1]}\n\n{self.matrix[1][0]}   {self.matrix[1][1]}"

        if self.choice == self.choices[0]:
            self.answerMatrix = [[self.matrix[0][0],self.matrix[0][1]], [-(self.matrix[1][0]),-(self.matrix[1][1])]]
        elif self.choice == self.choices[1]:
            self.answerMatrix = [[-(self.matrix[0][0]),-(self.matrix[0][1])], [self.matrix[1][0],self.matrix[1][1]]]
        else:
            self.angle = math.radians(random.randint(1,179))
            self.degreeAngle = math.degrees(self.angle)
            a, b = self.matrix[0][0], self.matrix[0][1]
            c, d = self.matrix[1][0], self.matrix[1][1]
            self.answerMatrix = [
                [round(a*math.cos(self.angle) - c*math.sin(self.angle), 2), round(b*math.cos(self.angle) - d*math.sin(self.angle), 2)],
                [round(a*math.sin(self.angle) + c*math.cos(self.angle), 2), round(b*math.sin(self.angle) + d*math.cos(self.angle), 2)]]
            self.choice = f"Rotate the matrix by {self.degreeAngle} Degrees"
        self.answer = f"{round(self.answerMatrix[0][0])}   {round(self.answerMatrix[0][1])}\n\n{round(self.answerMatrix[1][0])}   {round(self.answerMatrix[1][1])}"

        self.answers = []
        for x in range(3):
            self.answers.append(
                f"{random.randint(int(self.answerMatrix[0][0])-1,int(self.answerMatrix[0][0])+1)}     {random.randint(int(self.answerMatrix[0][1])-1,int(self.answerMatrix[0][1])+1)}\n\n"
                f"{random.randint(int(self.answerMatrix[1][0])-1,int(self.answerMatrix[1][0])+1)}     {random.randint(int(self.answerMatrix[1][1])-1,int(self.answerMatrix[1][1])+1)}")

        self.answers.append(self.answer)
        random.shuffle(self.answers)
        self.answerSpot = self.answers.index(self.answer) + 1

        return f"{self.choice}:\n\n{self.questionFormat}", self.answers[0], self.answers[1], self.answers[2], self.answers[3], qNum, self.answerSpot

    from fractions import Fraction

    from fractions import Fraction

    def simultaneousEquations(self, qNum):

        while True:
            self.matrix = [[random.randint(0,9), random.randint(0,9)],
                        [random.randint(0,9), random.randint(0,9)]]

            self.det = self.matrix[0][0] * self.matrix[1][1] - self.matrix[0][1] * self.matrix[1][0]

            if self.det != 0:
                break  

        self.rightSide = [random.randint(0,9), random.randint(0,9)]

        self.solution = np.linalg.solve(self.matrix, self.rightSide)
        
        xFrac = Fraction(self.solution[0]).limit_denominator()
        yFrac = Fraction(self.solution[1]).limit_denominator()
        
        self.answers = []

        self.questionFormat = (f" ⎡ {self.matrix[0][0]}   {self.matrix[0][1]} ⎤   ⎡ x ⎤     ⎡ {self.rightSide[0]} ⎤\n"
    f" ⎣ {self.matrix[1][0]}   {self.matrix[1][1]} ⎦ · ⎣ y ⎦ = ⎣ {self.rightSide[1]} ⎦")

        for i in range(0, 3):
            offsetX = Fraction(random.choice([-1, 1]), random.randint(2, 5))
            offsetY = Fraction(random.choice([-1, 1]), random.randint(2, 5))
            
            wrongX = xFrac + offsetX
            wrongY = yFrac + offsetY
            
            self.answers.append(f"x = {wrongX}\ny = {wrongY}")

        
        self.solution = f"x = {xFrac}\ny = {yFrac}"
        self.answers.append(self.solution)
        random.shuffle(self.answers)
        self.answerSpot = self.answers.index(self.solution) + 1

        return f"Solve this simultaneous equation using matrices:\n\n{self.questionFormat}", self.answers[0], self.answers[1], self.answers[2], self.answers[3], qNum, self.answerSpot
    
