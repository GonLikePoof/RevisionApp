        self.totalQuestions = questionAmount
        self.amountCorrect.config(text=f"Your score: {self.controller.correct}/{questionAmount}")
        self.scorePercentage = int((self.controller.correct/questionAmount)*100)
        self.percentage.config(text=f"This is {self.scorePercentage}%")


    def getStartTime(self, startTime):
        self.startTime = startTime
        self.timeEnd = time.time()
        self.elapsedTime = self.timeEnd-self.startTime
        self.minutes = round(self.elapsedTime//60)
        self.seconds = round(self.elapsedTime%60)
        if self.seconds < 10:
            self.seconds = f"0{self.seconds}"
        self.timeTaken.config(text=f"You took {self.minutes}:{self.seconds}")
   
    def saveQuiz(self):
        if self.minutes == 0:
            self.invalidTest = tk.Label(self, text="This test took you under a minute, so this will \n not count as a test, and so will not \n be saved. ", bg="#B4E5A2", font=("Helvetica", 14), fg = "red")
            self.invalidTest.place(x=80, y=320)
        else:
            cursor.execute('''INSERT INTO quiz (userid, score, total_questions, date_taken, duration)
                           VALUES (?, ?, ?, ?, ?)''',
                           (self.controller._currentUser["userid"], self.controller.correct, self.totalQuestions, date.today().isoformat(), int(self.elapsedTime)))
            conn.commit()

    def updateUserInfo(self):
        super().updateUserInfo()  
