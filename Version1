            questionsLabel = tk.Label(self.recentFrame, text=total, bg="white", font=("Helvetica", 9))
            questionsLabel.grid(row=i+1, column=2, padx=10, pady=2)
            self.recentLabels.append(questionsLabel)
            
            timeLabel = tk.Label(self.recentFrame, text=f"{minutes}:{seconds:02d}", bg="white", font=("Helvetica", 9))
            timeLabel.grid(row=i+1, column=3, padx=10, pady=2)
