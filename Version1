        user = self.controller._currentUser
        if user is None:
            return
            
        cursor.execute('''
            SELECT COUNT(*), AVG((score * 100.0) / total_questions), 
                   MAX((score * 100.0) / total_questions), SUM(duration)
            FROM quiz 
            WHERE userid = ?
        ''', (user["userid"],))
        
        stats = cursor.fetchone()
        
        if stats[0]:
            totalQuizzes = stats[0]
        else:
            totalQuizzes = 0
        
        if stats[1]:
            avgScore = round(stats[1], 1)
        else:
            avgScore = 0
        
        if stats[2]:
            bestScore = round(stats[2], 1)
        else:
            bestScore = 0
        
        if stats[3]:
            totalDuration = stats[3]
        else:
            totalDuration = 0
        
        self.totalQuizzes.config(text=f"Total Quizzes: {totalQuizzes}")
        self.avgScore.config(text=f"Average Score: {avgScore}%")
        self.bestScore.config(text=f"Best Score: {bestScore}%")
        
        hours = totalDuration // 3600
        minutes = (totalDuration % 3600) // 60
        self.totalTime.config(text=f"Total Time: {hours}h {minutes}m")
        
        cursor.execute('''
            SELECT date_taken, score, total_questions, duration
            FROM quiz
            WHERE userid = ?
            ORDER BY date_taken DESC
        ''', (user["userid"],))
        
        recentQuizzes = cursor.fetchall()
        
        for label in self.recentLabels:
            label.destroy()
        self.recentLabels = []
        
        for i, quiz in enumerate(recentQuizzes):
            dateTaken = quiz[0]
            score = quiz[1]
            total = quiz[2]
            duration = quiz[3]
            
            minutes = duration // 60
            seconds = duration % 60
            
            dateLabel = tk.Label(self.recentFrame, text=dateTaken, bg="white", font=("Helvetica", 9))
            dateLabel.grid(row=i+1, column=0, padx=10, pady=2)
